import hashlib
import json
import threading
import time
from pathlib import Path

from watchdog.events import FileSystemEventHandler
from watchdog.observers import Observer


class FileIntegrityMonitor:
    """Watch a directory and alert when files are created, changed, or removed."""

    DEFAULT_DANGEROUS_EXTENSIONS = {
        ".exe",
        ".dll",
        ".bat",
        ".cmd",
        ".com",
        ".js",
        ".vbs",
        ".ps1",
        ".scr",
        ".hta",
        ".lnk",
        ".jar",
    }

    def __init__(
        self,
        directory_to_watch,
        alerter,
        recursive=True,
        baseline_path=None,
        suspicious_extensions=None,
        burst_threshold=20,
        burst_window_seconds=5.0,
    ):
        self.directory = Path(directory_to_watch).expanduser().resolve()
        self.directory.mkdir(parents=True, exist_ok=True)
        self.alerter = alerter
        self.recursive = recursive
        self._observer = None
        self._lock = threading.RLock()
        self._snapshot = self._capture_snapshot()
        self._event_handler = _IntegrityEventHandler(self)
        self.baseline_path = Path(baseline_path).expanduser().resolve() if baseline_path else None
        self.baseline_manager = None
        if self.baseline_path is not None:
            self.baseline_manager = BaselineManager(self.baseline_path)
        self.suspicious_extensions = set((suspicious_extensions or set())) | self.DEFAULT_DANGEROUS_EXTENSIONS
        self.burst_threshold = max(1, int(burst_threshold))
        self.burst_window_seconds = max(1.0, float(burst_window_seconds))
        self._burst_events = []

    @staticmethod
    def _hash_file(path: Path) -> dict:
        digest = hashlib.sha256()
        size = 0
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
                size += len(chunk)
        stat = path.stat()
        return {"sha256": digest.hexdigest(), "size": size, "mtime_ns": stat.st_mtime_ns}

    def _relative_path(self, path: Path):
        try:
            return path.resolve().relative_to(self.directory).as_posix()
        except (OSError, ValueError):
            return None

    def _capture_snapshot(self) -> dict:
        snapshot = {}
        for path in sorted(self.directory.rglob("*")):
            if path.is_symlink() or not path.is_file():
                continue
            relative = self._relative_path(path)
            if relative is None:
                continue
            try:
                snapshot[relative] = self._hash_file(path)
            except OSError:
                continue
        return snapshot

    def _is_dangerous_file(self, relative_path: str) -> bool:
        suffix = Path(relative_path).suffix.lower()
        return suffix in self.suspicious_extensions

    def _record_change(self, event_type: str, relative: str, details: dict):
        severity = "CRITICAL" if self._is_dangerous_file(relative) else "HIGH"
        title = f"Suspicious File {event_type.title()}" if self._is_dangerous_file(relative) else f"File {event_type.title()}"
        self.alerter.trigger(
            module="FIM",
            severity=severity,
            title=title,
            details={"path": relative, **details},
            dedup_key=f"fim:{event_type}:{relative}",
        )
        self._track_burst(relative)

    def _track_burst(self, relative_path: str):
        now = time.monotonic()
        self._burst_events.append((now, relative_path))
        cutoff = now - self.burst_window_seconds
        self._burst_events = [item for item in self._burst_events if item[0] >= cutoff]

        if len(self._burst_events) >= self.burst_threshold:
            unique_paths = sorted({path for _, path in self._burst_events})
            self.alerter.trigger(
                module="FIM",
                severity="CRITICAL",
                title="Burst Activity Detected",
                details={
                    "window_seconds": self.burst_window_seconds,
                    "event_count": len(self._burst_events),
                    "paths": unique_paths[:10],
                },
                dedup_key="fim:burst-activity",
            )
            self._burst_events.clear()

    def _check_startup_health(self):
        if not self.directory.exists():
            raise FileNotFoundError(f"Watch directory does not exist: {self.directory}")
        if not self.directory.is_dir():
            raise NotADirectoryError(f"Watch path is not a directory: {self.directory}")
        if self.baseline_path is not None:
            if self.baseline_path.exists() and self.baseline_path.is_dir():
                raise IsADirectoryError(f"Baseline path points to a directory: {self.baseline_path}")
            if self.baseline_path.exists():
                try:
                    json.loads(self.baseline_path.read_text(encoding="utf-8"))
                except (OSError, ValueError) as exc:
                    raise ValueError(f"Baseline file is invalid JSON: {self.baseline_path}") from exc
            else:
                self.baseline_path.parent.mkdir(parents=True, exist_ok=True)
        self.alerter.trigger(
            module="FIM",
            severity="LOW",
            title="Health Check Passed",
            details={"directory": str(self.directory), "baseline": str(self.baseline_path) if self.baseline_path else None},
            dedup_key="fim:startup-health",
        )

    def _handle_file_event(self, event_type: str, raw_path: str):
        path = Path(raw_path)
        if path.is_symlink() or path.is_dir():
            return
        relative = self._relative_path(path)
        if relative is None:
            return

        with self._lock:
            previous = self._snapshot.get(relative)
            if event_type == "deleted" or not path.exists():
                if previous is not None:
                    self._snapshot.pop(relative, None)
                    self._record_change("deleted", relative, {"previous_state": previous})
                return

            try:
                current = self._hash_file(path)
            except OSError:
                return

            if previous is None:
                self._snapshot[relative] = current
                self._record_change("created", relative, {"current_state": current})
            elif previous != current:
                self._snapshot[relative] = current
                self._record_change(
                    "modified",
                    relative,
                    {"previous_state": previous, "current_state": current},
                )

    def _check_baseline(self):
        if not self.baseline_manager:
            return
        result = self.baseline_manager.compare(self.directory)
        if result["added"] or result["removed"] or result["changed"]:
            for rel in result["added"]:
                self.alerter.trigger(
                    module="FIM",
                    severity="HIGH",
                    title="Baseline Drift: File Added",
                    details={"path": rel, "current_state": result["current"].get(rel)},
                    dedup_key=f"fim:baseline-added:{rel}",
                )
            for rel in result["removed"]:
                self.alerter.trigger(
                    module="FIM",
                    severity="HIGH",
                    title="Baseline Drift: File Removed",
                    details={"path": rel, "previous_state": result["baseline"].get(rel)},
                    dedup_key=f"fim:baseline-removed:{rel}",
                )
            for rel in result["changed"]:
                self.alerter.trigger(
                    module="FIM",
                    severity="HIGH",
                    title="Baseline Drift: File Changed",
                    details={
                        "path": rel,
                        "previous_state": result["baseline"].get(rel),
                        "current_state": result["current"].get(rel),
                    },
                    dedup_key=f"fim:baseline-changed:{rel}",
                )
        else:
            self.alerter.trigger(
                module="FIM",
                severity="LOW",
                title="Baseline Matched",
                details={"baseline": str(self.baseline_path), "tracked_files": len(result["current"])},
                dedup_key="fim:baseline-match",
            )

    def start(self):
        if self._observer is not None:
            raise RuntimeError("FileIntegrityMonitor is already running")

        self._check_startup_health()

        if self.baseline_manager and not self.baseline_path.exists():
            self.baseline_manager.save(self.directory)
            self.alerter.trigger(
                module="FIM",
                severity="LOW",
                title="Baseline Created",
                details={"baseline": str(self.baseline_path), "tracked_files": len(self._snapshot)},
                dedup_key="fim:baseline-create",
            )
        elif self.baseline_manager:
            self._check_baseline()

        observer = Observer()
        observer.schedule(self._event_handler, str(self.directory), recursive=self.recursive)
        observer.start()
        self._observer = observer
        self.alerter.trigger(
            module="FIM",
            severity="LOW",
            title="Monitoring Started",
            details={"directory": str(self.directory), "tracked_files": len(self._snapshot)},
            dedup_key="fim:start",
        )
        return observer

    def stop(self):
        observer = self._observer
        if observer is not None:
            observer.stop()
            observer.join()
            self._observer = None


class _IntegrityEventHandler(FileSystemEventHandler):
    def __init__(self, monitor):
        self.monitor = monitor

    def on_created(self, event):
        if not event.is_directory:
            self.monitor._handle_file_event("created", event.src_path)

    def on_modified(self, event):
        if not event.is_directory:
            self.monitor._handle_file_event("modified", event.src_path)

    def on_deleted(self, event):
        if not event.is_directory:
            self.monitor._handle_file_event("deleted", event.src_path)

    def on_moved(self, event):
        if not event.is_directory:
            self.monitor._handle_file_event("deleted", event.src_path)
            self.monitor._handle_file_event("created", event.dest_path)


class BaselineManager:
    """Store and compare a known-good file snapshot for a watched directory."""

    def __init__(self, baseline_path):
        self.baseline_path = Path(baseline_path)
        self.baseline_path.parent.mkdir(parents=True, exist_ok=True)

    def _hash_file(self, path: Path) -> dict:
        digest = hashlib.sha256()
        size = 0
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(65536), b""):
                digest.update(chunk)
                size += len(chunk)
        stat = path.stat()
        return {"sha256": digest.hexdigest(), "size": size, "mtime_ns": stat.st_mtime_ns}

    def capture(self, directory: Path) -> dict:
        snapshot = {}
        if not directory.exists():
            return snapshot
        for path in sorted(directory.rglob("*")):
            if path.is_symlink() or not path.is_file():
                continue
            try:
                rel = path.resolve().relative_to(directory).as_posix()
            except ValueError:
                continue
            snapshot[rel] = self._hash_file(path)
        return snapshot

    def save(self, directory: Path) -> dict:
        snapshot = self.capture(directory)
        payload = {
            "generated_at": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat(),
            "files": snapshot,
        }
        self.baseline_path.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
        return snapshot

    def load(self) -> dict:
        if not self.baseline_path.exists():
            return {}
        try:
            return json.loads(self.baseline_path.read_text(encoding="utf-8")).get("files", {})
        except (OSError, ValueError):
            return {}

    def compare(self, directory: Path):
        current = self.capture(directory)
        baseline = self.load()
        added = sorted(set(current) - set(baseline))
        removed = sorted(set(baseline) - set(current))
        changed = []
        for rel in sorted(set(current) & set(baseline)):
            if current[rel] != baseline[rel]:
                changed.append(rel)
        return {"added": added, "removed": removed, "changed": changed, "current": current, "baseline": baseline}
